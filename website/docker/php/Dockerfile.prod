# Build Symfony vendor/ with Composer, then copy into a slim PHP-FPM runtime image.

FROM composer:2 AS vendor
WORKDIR /app

COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-dev --prefer-dist --no-interaction --no-progress --optimize-autoloader

FROM php:8.4-fpm

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    libicu-dev \
    libzip-dev \
    zlib1g-dev \
  && docker-php-ext-install -j$(nproc) intl opcache zip \
  && pecl install apcu \
  && docker-php-ext-enable apcu \
  && rm -rf /var/lib/apt/lists/*

COPY docker/php/conf.d/app.ini /usr/local/etc/php/conf.d/app.ini

WORKDIR /var/www/backend

# App code
COPY backend/ /var/www/backend/

# Dependencies
COPY --from=vendor /app/vendor /var/www/backend/vendor

# Ensure writable dirs exist (persisted via named volume in compose)
RUN mkdir -p var/cache var/log \
  && chown -R www-data:www-data var
