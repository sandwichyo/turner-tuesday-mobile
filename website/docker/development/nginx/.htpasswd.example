# Copy this file to docker/nginx/.htpasswd and replace the placeholder line
# with output from a command like one of these:
#
#   htpasswd -nbB your-user your-password
#   docker run --rm httpd:2.4-alpine htpasswd -nbB your-user your-password
#
# Example format:
# your-user:$2y$05$examplehashedvaluehere
